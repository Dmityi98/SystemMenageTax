# ===========================================
# SMT.API Environment Variables Configuration
# ===========================================

# -------------------------------------------
# Database Connection (PostgreSQL)
# -------------------------------------------
# Внимание: Используйте сложные пароли в production!
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=SMTDb;Username=postgres;Password=admin
DbConnection=Host=localhost;Port=5432;Database=SMTDb;Username=postgres;Password=admin

# -------------------------------------------
# JWT Configuration
# -------------------------------------------
# SecretKey должен быть минимум 32 символа (рекомендуется 64)
# Сгенерируйте безопасный ключ: openssl rand -base64 64
JwtOptions__SecretKey=YOUR_SECURE_SECRET_KEY_HERE_MINIMUM_64_CHARACTERS_LONG_RANDOM_STRING
JwtOptions__Issuer=SMTAPI
JwtOptions__Audience=SMTClient
JwtOptions__ExpiresHours=12
JwtOptions__AccessTokenExpiresMinutes=30